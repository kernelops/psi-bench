# Build context: the volepsi repo root (local checkout, so the exact commit is benchmarked)
# 24.04 (GCC 13): the pinned libOTe uses C++20 <format>, absent in GCC 11 (22.04)
FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential cmake git libtool autoconf automake pkg-config libssl-dev iproute2 python3 sudo ca-certificates time \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/volepsi
COPY . .
RUN python3 build.py -DVOLE_PSI_ENABLE_BOOST=ON && test -x out/build/linux/frontend/frontend
WORKDIR /app/volepsi/out/build/linux/frontend
